<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bartender_bringup</name>
  <version>0.0.0</version>
  <description>Top-level launch files bringing up sim, control, and MoveIt together</description>
  <maintainer email="azmozgame@gmail.com">ami</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>bartender_gazebo</depend>
  <depend>bartender_description</depend>
  <depend>bartender_pour</depend>
  <depend>bartender_moveit_config</depend>
  <depend>controller_manager</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <!-- workcell_real.launch.py only. exec_ so the sims still build without it. -->
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_client_library</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
