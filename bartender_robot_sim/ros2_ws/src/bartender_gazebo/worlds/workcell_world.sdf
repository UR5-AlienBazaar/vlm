<?xml version="1.0" ?>
<!--
  The real workcell, for simulating it: a 1.40 x 0.70 table and one UR5e.

  There is no table in this file. It is a link of the robot description
  (bartender_description/urdf/workcell.urdf.xacro), so the same table is in
  Gazebo, in MoveIt, and on the real robot where there is no Gazebo; see the
  xacro's header for the layout and why. sim.launch.py spawns that
  description with its `world` frame, the table's corner, at the top of the
  table (0, 0, table_height).

  Physics, plugins, light and ground are the bar world's, unchanged; its
  comments say why they are what they are. The bar's three bottles stand on
  the table in a line 0.40 in front of the arm's base; there is no glass.
-->
<sdf version="1.9">
  <world name="workcell_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- Bullet rather than DART's default FCL narrowphase. This is the
           single biggest lever on how long a pour takes, and it costs nothing
           in fidelity.

           Every link of the arm and gripper has a triangle-mesh collision.
           Under FCL, the moment the gripper takes the bottle's weight the
           real-time factor collapses from 1.0 to ~0.1, so trajectories that
           are timed at 0.6-1.7s take 5-12s of wall clock. It is specifically
           the loaded mesh contact: clamping on the bottle while it still rests
           on the counter stays at RTF 1.0, and it recovers the instant the
           bottle is released.

           Measured over 4 pours each, same code, only this setting changed:
             FCL     87.4 / 86.1 / 79.9 / 79.8 s
             bullet  24.6 / 24.2 / 24.3 s
           Both 4/4 with the bottle returned upright and within 8mm of its
           station, so this buys ~3.4x for free.

           Two things that did NOT work, for whoever tries next: halving the
           step count (max_step_size 0.001 -> 0.002) changed the ratio not at
           all, and raising the joint acceleration limits made the planned
           trajectories shorter but the execution no faster - faster motion
           just makes the contact solve harder by the same factor, and it
           starts throwing the bottle. -->
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- The bar's bottles, on the table top (z = table_height). Label plugins
         tag them for segmentation cameras; the numbers are LABEL_IDS in
         UR5-AlienBazaar/vlm training/vlm_labels.py, the same as the bar's.
         scripts/capture_workcell_scenes.py moves them around per scene. -->
    <include>
      <uri>model://jack_daniels_bottle</uri>
      <name>jack_daniels_bottle</name>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>1</label>
      </plugin>
      <pose>0.75 0.20 0.75 0 0 0</pose>
    </include>

    <include>
      <uri>model://cola_bottle</uri>
      <name>cola_bottle</name>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>2</label>
      </plugin>
      <pose>0.75 0.35 0.75 0 0 0</pose>
    </include>

    <include>
      <uri>model://beer_bottle</uri>
      <name>beer_bottle</name>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>3</label>
      </plugin>
      <pose>0.75 0.50 0.75 0 0 0</pose>
    </include>

    <!-- Held on by the DetachableJoint in beer_bottle's model.sdf, which finds
         it by this name; see bar_world.sdf. 0.2581 is the bottle's lip. -->
    <include>
      <uri>model://beer_cap</uri>
      <name>beer_cap</name>
      <pose>0.75 0.50 1.0081 0 0 0</pose>
    </include>
    <!-- A fixed view of the whole cell for watching the twin
         (scripts/workcell_viewer.py). Not a model of the real camera, whose
         mount is not decided yet; the VLM captures use their own. -->
    <model name="workcell_view_camera">
      <static>true</static>
      <pose>1.90 -0.40 1.50 0 0.487 2.583</pose>
      <link name="link">
        <sensor name="view_rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/workcell/view_camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.2566</horizontal_fov>
            <image><width>640</width><height>400</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>6.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
