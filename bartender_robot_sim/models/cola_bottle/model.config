<?xml version="1.0"?>
<model>
  <name>cola_bottle</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Bartender Robot Project</name>
    <email>azmozgame@gmail.com</email>
  </author>

  <description>
    A 500ml glass cola bottle (25cm tall, 6.75cm at its widest), converted
    from the supplied models/colaglass.obj. That file contained two copies of
    the bottle -- the second missing its cap and liquid -- so only the
    complete one was kept. Visual uses the detailed mesh; collision uses three
    cylinders following the contour profile, for stable grasping physics.
  </description>
</model>
