<?xml version="1.0"?>
<model>
  <name>jack_daniels_bottle</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Bartender Robot Project</name>
    <email>azmozgame@gmail.com</email>
