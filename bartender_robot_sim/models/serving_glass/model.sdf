<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="serving_glass">
    <!-- Link origin is the center of the glass's base. -->
    <link name="glass_link">
      <inertial>
        <pose>0 0 0.045 0 0 0</pose>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0003225</ixx>
          <iyy>0.0003225</iyy>
          <izz>0.00024</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="glass_visual">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.6 0.7 0.7 0.4</ambient>
          <diffuse>0.7 0.85 0.85 0.4</diffuse>
          <specular>0.9 0.9 0.9 0.6</specular>
        </material>
      </visual>

      <collision name="glass_collision">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.7</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
